# ---- secrets ----
.env
*.key
*.pem
secrets*
**/.opencode/opencode.key

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
build/
dist/

# ---- node ----
**/node_modules/

# ---- opencode runtime (caches/binaries; agent cards + skills ARE kept) ----
**/.opencode/tools/
**/.opencode/node_modules/

# ---- neutral vendored tools (large binaries; fetch on demand, see docs/VENDORED-TOOLS.md) ----
product-forge/vendor/**
!product-forge/vendor/README.md

# ---- git worktrees (engineering worker isolation, ENG-3) ----
product-forge-worktrees/

# ---- local archive + test containers (kept on disk, not shipped) ----
product-forge/archive/
product-forge/products/test-project/
**/test_product/
# ---- throwaway test-run artifacts (regenerable; BI-PF-0255) ----
product-forge/products/e2e-smoke/
product-forge/products/smoke-all/
product-forge/test-framework/reports/

# ---- runtime caches / generated ----
# API idempotency store (ephemeral runtime state)
product-forge/data/api/
# tool secrets (web_search api_key etc.; non-secret settings.json is kept) - BI-PF-0439
product-forge/data/tools/secrets.json
product-forge/data/local/
# EDP-03 (BI-PF-1295): runtime SQLite DBs are never version-controlled (schema is created in code)
product-forge/data/control-plane/*.db*
product-forge/data/portfolio/*.db*
**/.llm-cache/
**/.input-cache/
product-forge/products/**/backups/
product-forge/products/**/checkpoints/
*.log

# ---- BI-PF-1257: ephemeral runtime stores (regenerated live; NEVER checkpointed to develop) ----
# rationalised by core/state_checkpoint.py (durable allowlist); these are runtime evidence/state/run outputs.
product-forge/events.jsonl
product-forge/quality-gate.json
product-forge/validation/
product-forge/github/
product-forge/data/provider-health.json
product-forge/data/portfolio/portfolio-state.json
product-forge/products/.locks/
product-forge/products/default/
product-forge/products/pf-eng10-*/
product-forge/products/product-forge/
product-forge/products/*/events.jsonl
product-forge/products/*/call-ledger.jsonl
product-forge/products/*/run-status.json
product-forge/products/*/run-plan.json
product-forge/products/*/model-gate.json
product-forge/products/*/plan-review.json
product-forge/products/*/readiness.json
product-forge/products/*/work-estimate.json
product-forge/products/*/run-manifests/
product-forge/products/*/logs/
product-forge/products/*/memory/
product-forge/products/*/compliance/
product-forge/test-framework/results/

# ---- source snapshots (never distribute/commit) ----
*.bak_pre_*
*.bak

# ---- os / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- BI-PF-0396 (A2): license secrets never ship ----
# private/dev keys and per-install generated public key: MUST NOT be committed
product-forge/data/licensing/.dev-private-key
product-forge/data/licensing/.signing-key
product-forge/data/licensing/license-public-key

# backlog writer lock (runtime; never committed)
**/backlog/.lock

# Go build artifacts (never committed)
product-forge/go/**/*.exe
product-forge/go/**/*.test

# local object store (runtime; never committed)
product-forge/data/local/objects/

# migration rollback snapshots (runtime; never committed)
product-forge/.migration-snapshot/
