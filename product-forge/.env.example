# Provider credentials — copy to .env and fill in. NEVER commit the real .env.
# The engine loads product-forge/.env (ROOT-anchored) via core/credentials.py (BI-0207).
# See docs/credentials.md.

# --- LLM providers (pick the one your tier uses) ---
OPENCODE_ZEN_API_KEY=        # provider: opencode-go / opencode-zen  (default tier)
OPENROUTER_API_KEY=          # provider: openrouter   (e.g. tier free-trial-fast)
GEMINI_API_KEY=              # provider: gemini
OPENAI_API_KEY=              # provider: openai
ANTHROPIC_API_KEY=           # provider: anthropic

# --- Media providers (optional; later capability packs) ---
FAL_KEY=                     # aggregator: image/video/3d/music
REPLICATE_API_TOKEN=         # aggregator: image/video/3d/music
KIE_API_KEY=                 # aggregator: image/video
ELEVENLABS_API_KEY=          # direct: tts
DEEPGRAM_API_KEY=            # direct: stt

# --- Budget caps (0 = uncapped) ---
# (caps themselves live in config/provider-keys.json)
