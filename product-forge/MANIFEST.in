include README.md
include LICENSE
include pyproject.toml
include install.py
include install.bat
include install.sh

recursive-include core *.py
recursive-include pipeline_dashboard *.py *.html *.css *.js
recursive-include pipeline_dashboard/docs *
recursive-include products *
recursive-include scripts *.py *.md
recursive-include .opencode *.md
recursive-include test-framework *.py *.md *.toml *.ini

recursive-exclude * __pycache__
recursive-exclude * *.pyc
recursive-exclude * *.pyo
recursive-exclude * .pytest_cache
recursive-exclude * .mypy_cache
recursive-exclude * .git