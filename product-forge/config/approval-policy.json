{
  "_doc": "PIDL approval policy (BI-PF-0380). Determines whether authenticated human approval is required before a consequential action. Owner (single writer): core/pidl.py. Read-only at decision time.",
  "version": 1,
  "default": {"requires_approval": false, "approver": "operator", "escalation_allowed": true},
  "rules": [
    {
      "id": "AP-001",
      "match": {"keywords": ["architecture", "security", "destructive", "irreversible", "production",
                             "deploy", "release", "publish", "license", "financial", "delete", "drop",
                             "migration", "schema"]},
      "requires_approval": true,
      "approver": "operator"
    },
    {
      "id": "AP-002",
      "match": {"areas": ["security", "release"]},
      "requires_approval": true,
      "approver": "security-owner"
    }
  ]
}
