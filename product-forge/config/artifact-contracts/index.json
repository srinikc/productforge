{
  "$schema": "pf-artifact-contracts-v1",
  "version": 1,
  "doc": "Artifact Contract Registry. ONE entry per artifact type an agent/stage produces. Gives each agent the GIVEN format/semantics (sections + counts + size budget) so output is bounded by construction, not free-flow. Two tiers: 'universal' (same for every project kind) and 'modality' (selected by project kind: text/video/image/music/voice/3d/sensor/mixed). Source + license + integrity are stored so contracts can be REFRESHED from upstream. Owner: core/contracts.py (loader/validator). Data-only descriptor; no runtime network.",
  "tiers": {
    "universal": "applies to every project kind",
    "modality": "selected by detected project kind (see applies_to)"
  },
  "contracts": {
    "product.vision": {
      "title": "Product Vision / Opportunity",
      "tier": "universal",
      "applies_to": ["*"],
      "standard": "Lean Canvas (Ash Maurya) + Product Vision Board (Roman Pichler)",
      "standard_version": "n/a",
      "source": {"canonical_url": "https://leanstack.com/lean-canvas", "docs_url": "https://www.romanpichler.com/tools/product-vision-board/"},
      "license": {"spdx": "CC-BY-SA-4.0", "url": "https://creativecommons.org/licenses/by-sa/4.0/"},
      "format_version": "1.0.0",
      "status": "standard",
      "sections": ["Problem", "Customer Segments", "Unique Value Proposition", "Solution", "Channels", "Revenue Streams", "Cost Structure", "Key Metrics", "Unfair Advantage"],
      "counts": {"problems": "<=3", "segments": "<=3", "solution_features": "<=3"},
      "size": {"target_lines": 60, "max_lines": 120},
      "refresh": {"mode": "manual", "cadence_days": 180}
    },
    "product.prd": {
      "title": "Product Requirements Document (PRD)",
      "tier": "universal",
      "applies_to": ["*"],
      "standard": "Modern PRD (12-section markdown)",
      "standard_version": "2025",
      "source": {"canonical_url": "https://github.com/ugur10/prd-template", "raw_template_url": "https://raw.githubusercontent.com/ugur10/prd-template/main/PRD_TEMPLATE.md"},
      "license": {"spdx": "MIT", "url": "https://github.com/ugur10/prd-template"},
      "format_version": "1.0.0",
      "status": "standard",
      "sections": ["Problem", "Goals & Success Metrics", "Personas & Use Cases", "Functional Requirements", "Non-Functional Requirements", "Dependencies & Risks", "Release Criteria", "Open Questions"],
      "counts": {"functional_requirements": "<=N per feature, scaled by complexity", "personas": "<=3"},
      "size": {"target_lines": 150, "max_lines": 300},
      "refresh": {"mode": "check", "cadence_days": 180}
    },
    "requirements.srs": {
      "title": "Software Requirements Specification (SRS)",
      "tier": "universal",
      "applies_to": ["*"],
      "standard": "ISO/IEC/IEEE 29148:2018 (SRS outline) + ISO/IEC 25010 (quality)",
      "standard_version": "2018",
      "source": {"canonical_url": "https://www.iso.org/standard/72089.html", "docs_url": "https://standards.ieee.org/ieee/29148/5732/"},
      "license": {"spdx": "NOASSERTION", "url": "https://www.iso.org/standard/72089.html"},
      "format_version": "1.0.0",
      "status": "standard",
      "sections": ["Introduction & Scope", "Overall Description", "Functional Requirements", "Non-Functional Requirements", "Constraints", "User Stories", "Traceability Matrix"],
      "counts": {"functional_requirements": "scaled per feature (no fixed count)", "nfr": "product-wide, stated ONCE"},
      "size": {"target_lines": 200, "max_lines": 400},
      "refresh": {"mode": "manual", "cadence_days": 365}
    },
    "design.ux": {
      "title": "UX / Design Specification",
