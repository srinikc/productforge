      "status": "standard",
      "sections": ["Design Direction", "UX Patterns", "Information Architecture", "Component Breakdown", "Empty/Loading/Error States", "Accessibility (A/AA)", "Internationalization", "Edge Cases"],
      "counts": {"components": "per feature (bounded)"},
