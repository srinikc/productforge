{
  "$schema": "artifact-formats-v1",
  "description": "Single source of truth for dynamic artifact output formats (BI-0110). md is the canonical default for every artifact; extras are chosen per agent/kind/project and filtered by emitter availability.",
  "default": ["md"],
  "by_agent": {
    "ideation": ["md", "html"],
    "discovery": ["md", "html", "xlsx"],
    "research": ["md", "pdf"],
    "architect": ["md", "pdf"],
    "design": ["md", "pdf", "html"],
    "product-design-spec": ["md", "pdf", "html"],
    "document": ["md", "pdf"],
    "marketing": ["md", "pptx"],
    "product-analyzer": ["md", "xlsx"],
    "qa": ["md", "xlsx"]
  },
  "by_kind": {
    "spec": ["md", "pdf", "html"],
    "deck": ["md", "pptx"],
    "test-results": ["md", "xlsx"],
    "data-model": ["md", "svg"],
    "report": ["md", "pdf"]
  },
  "project_overrides": {},
  "capability_fallback": true
}
