{
  "_doc": "Canonical log locations + file naming. Owner: core/log_router.py. One layout for product runs, the pipeline backend itself, and (later) the dashboard.",
  "layout": {
    "product_runs": "products/<project>/logs/<run_id>/",
    "pipeline_backend": "product-forge/logs/",
    "dashboard": "dashboard/logs/"
  },
  "naming": {
    "per_agent": "<stage>-<agent>.log",
    "run_overall": "<run_id>-pipeline.log",
    "backend": "pipeline-backend.log",
    "dashboard": "dashboard.log",
    "index": "INDEX.json"
  },
  "line_format": "ts | level | run_id | stage | agent | event | message",
  "rotation": {"max_bytes": 5242880, "backup_count": 5, "keep_runs": 20},
  "sanitize": {"replace": [" ", "/", "\\\\", ":"], "with": "-", "lowercase": true}
}
