{
  "schema": "pf.ownership/1",
  "owners": [
    {
      "glob": "go/edpsvc/**",
      "owner": "edpsvc"
    },
    {
      "glob": "go/edpdata/**",
      "owner": "edpdata"
    },
    {
      "glob": "go/store/**",
      "owner": "store"
    },
    {
      "glob": "migrations/**",
      "owner": "schema"
    },
    {
      "glob": "scripts/dev/**",
      "owner": "tooling"
    },
    {
      "glob": "test-framework/**",
      "owner": "tests"
    },
    {
      "glob": "docs/**",
      "owner": "docs"
    },
    {
      "glob": "ops/**",
      "owner": "ops"
    },
    {
      "glob": "config/**",
      "owner": "config"
    },
    {
      "glob": "AGENTS.md",
      "owner": "framework"
    },
    {
      "glob": "templates/**",
      "owner": "framework"
    },
    {
      "glob": ".github/**",
      "owner": "ci"
    },
    {
      "glob": "core/**",
      "owner": "core"
    },
    {
      "glob": "api/**",
      "owner": "api"
    }
  ],
  "routes": [
    {
      "prefix": "/admin/backlog/authority",
      "owner": "edpsvc"
    },
    {
      "prefix": "/admin/",
      "owner": "edpsvc"
    },
    {
      "prefix": "/backlog",
      "owner": "edpsvc"
    }
  ]
}
