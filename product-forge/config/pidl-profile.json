{
  "_doc": "PIDL profile index (BI-PF-0376). PIDL owns this INDEX only - the rules/principles/preferences themselves stay in their canonical owner stores (core/forge_constitution.py, core/learnings.py, core/persona.py). Single writer: core/pidl.py. Read-only at decision time.",
  "version": 1,
  "categories": {
    "rules": {"sources": ["constitution", "learnings"], "strict_severities": ["mandatory"]},
    "principles": {
      "sources": ["constitution", "learnings"],
      "categories": ["safety", "quality", "execution", "architecture", "product", "ux", "security", "operations"]
    },
    "preferences": {"sources": ["persona"], "keys": ["must", "must_not", "knobs", "traits"]}
  },
  "review_lenses": ["architecture", "engineering", "QA", "product", "UX", "security", "operations"],
  "area_lenses": {
    "api": ["architecture", "security"],
    "security": ["security", "architecture"],
    "ui": ["UX", "product"],
    "dashboard": ["UX", "product"],
    "data": ["architecture", "operations"],
    "store": ["architecture", "operations"],
    "core": ["architecture", "engineering"],
    "scheduler": ["architecture", "engineering"],
    "worker": ["architecture", "operations"],
    "test": ["QA"],
    "doc": ["product"]
  },
  "approval_defaults": {"autonomy": "allowed", "approval_required": false, "escalation_allowed": true},
  "decision": {
    "review_below": 0.6,
    "escalate_failures": 3,
    "weights": {"factual": 0.2, "architectural": 0.2, "requirement_interpretation": 0.15,
                "user_preference": 0.15, "implementation": 0.3}
  },
  "consequential_keywords": [
    "architecture", "security", "destructive", "irreversible", "production", "deploy",
    "release", "publish", "license", "financial", "delete", "drop", "migration", "schema"
  ]
}
