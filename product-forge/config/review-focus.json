{
  "_doc": "Production-risk REVIEW FOCUS checklist (BI-PF-1066). Single source of truth, consumed by the code-review agent (runs per build iteration). Rendered to docs/REVIEW-FOCUS.md by scripts/dev/gen_review_focus.py and kept fresh by a precheck gate. Categories marked stage=design/architect are SHIFT-LEFT gates owned by earlier agents (E6/E7/E8).",
  "severity": {"critical": "BLOCK (verdict NEEDS FIXES; PR gate fails)", "high": "flag", "medium": "advisory", "low": "advisory"},
  "always_flag": ["auth", "authorization", "session", "payments", "billing", "data-deletion", "PII", "secrets"],
  "ignore": ["code style", "formatting", "naming preference", "import order", "line length"],
  "categories": [
    {"id": "business_logic", "stage": "review", "title": "Business-logic correctness",
     "checks": ["matches the requirement/acceptance criteria", "domain rule edge conditions", "no extra/undocumented behaviour"]},
    {"id": "security", "stage": "review", "title": "Security",
     "checks": ["authn/authz enforced at the boundary", "untrusted input validated", "no secrets in code/logs", "safe deserialization", "secure defaults"]},
    {"id": "injection", "stage": "review", "title": "Injection vectors",
     "checks": ["parameterized SQL (no string-built queries)", "no shell=True with input", "no eval/exec on input", "templating auto-escapes"]},
    {"id": "performance", "stage": "review", "title": "Performance",
     "checks": ["no N+1 queries", "bounded loops/queries", "indexes for query predicates", "no sync I/O in hot paths", "pagination on large reads"]},
    {"id": "edges", "stage": "review", "title": "Unhandled edge cases",
     "checks": ["null/empty/zero/overflow", "error + timeout paths", "retries idempotent", "concurrency/races", "partial-failure handling"]},
    {"id": "production_break", "stage": "review", "title": "What breaks in production?",
     "checks": ["runtime failure modes", "bad defaults/config", "missing migrations", "missing env/keys", "resource leaks"]},
    {"id": "contract", "stage": "review", "title": "Contract conformance (E5)",
     "checks": ["code matches the declared interface/API contract", "changes are backward-compatible"]},
    {"id": "migration", "stage": "review", "title": "Migrations & back-compat (E5)",
     "checks": ["schema changes have a migration", "no destructive change without a migration", "change is revertible"]},
    {"id": "config_secrets", "stage": "review", "title": "Config & secrets (E5)",
     "checks": ["new config/env keys are declared", "no hardcoded secrets", "defaults are safe"]},
    {"id": "failure_modes", "stage": "review", "title": "Failure modes (E5)",
     "checks": ["timeouts on external calls", "retries with backoff", "fallbacks, no silent swallow"]},
    {"id": "idempotency", "stage": "review", "title": "Idempotency & concurrency (E5)",
     "checks": ["writes idempotent", "safe retries", "no races"]},
    {"id": "observability", "stage": "review", "title": "Observability (E5)",
     "checks": ["new paths emit logs", "metrics where relevant"]},
    {"id": "test_adequacy", "stage": "review", "title": "Test adequacy (E5)",
     "checks": ["tests assert behaviour (not truthy)", "edge cases covered", "no assert True"]},
    {"id": "traceability", "stage": "review", "title": "Traceability (E8)",
     "checks": ["each requirement maps to code + test", "no untraced scope"]},
    {"id": "spec_design", "stage": "design", "title": "Spec/design gate (E6) - owned by design/spec_review",
     "checks": ["every requirement has TESTABLE acceptance criteria", "explicit NFR targets (perf/security/availability)", "edge/error cases enumerated"]},
    {"id": "architecture", "stage": "architect", "title": "Architecture/contract gate (E7) - owned by architecture-review",
     "checks": ["contracts defined", "migration strategy stated", "trust boundaries stated", "new dependencies resolve in the tool catalog with bundle_allowed"]}
  ]
}
