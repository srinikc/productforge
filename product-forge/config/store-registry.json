{
  "$schema": "store-registry-v1",
  "description": "Authoritative data stores for Product Forge. One truth per concern, one writer per file. Enforced by scripts/dev/wired_audit.py (store_audit).",
  "rules": [
    "work items live only in backlog/items/<ID>.json (truth), written only by core/backlog.py; open/closed.json are DERIVED indexes",
    "every artifact about work references item_id (BI-####); technical detail adds feature_id (F-x)",
    "derived files are generated, never hand-edited (kind=derived)",
    "new per-scope stores must live under products/<project>/ or product-forge/"
  ],
  "stores": {
    "open.json": {
      "owner": "core/backlog.py",
      "kind": "work-items",
      "scope": "project|product_forge",
      "concern": "DERIVED lean index of non-terminal work items (id/status/one-liner/dates)",
      "visibility": "shared"
    },
    "closed.json": {
      "owner": "core/backlog.py",
      "kind": "work-items",
      "scope": "project|product_forge",
      "concern": "DERIVED lean index of terminal work items (no full copies)",
