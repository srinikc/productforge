    def _tier_config_candidates(self) -> List[str]:
        """Ordered list of locations to look for the shared model-tier config."""
        repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        return [
            os.path.join(self.project_dir, "model-tier.json"),
            os.path.join(self.products_dir, "pipeline_dashboard", "model-tier.json"),
            os.path.join(self.products_dir, "model-tier.json"),
            os.path.join(repo_root, "model-tier.json"),
            os.path.join(repo_root, "config", "model-tier.json"),
        ]

    def _load_tier_config(self) -> Dict:
        """Load the shared model-tier config, checking project then shared paths.

        Results are cached on the instance to avoid re-reading per LLM call.
        """
        if getattr(self, "_tier_config_cache", None) is not None:
            return self._tier_config_cache

        config: Dict = {}
        for path in self._tier_config_candidates():
            if os.path.exists(path):
                try:
                    with open(path, "r", encoding="utf-8-sig") as f:
                        config = json.load(f)
                    print(f"[ModelRouter] Loaded tier config from {path}")
                    break
                except Exception as e:
                    print(f"[ModelRouter] Warning: could not read tier config {path}: {e}")

        self._tier_config_cache = config
        return config

    def _get_model_tier(self, agent_id: str, stage_id: str) -> Optional[str]:
        """Get model tier for agent from project or shared pipeline config."""
        config = self._load_tier_config()
        if config:
            # Stage-specific tier has precedence, then agent, then default
            if stage_id in config.get("stages", {}):
                tier = config["stages"][stage_id].get("tier")
                if tier:
                    return tier
            if agent_id in config.get("agents", {}):
                tier = config["agents"][agent_id].get("tier")
                if tier:
                    return tier
            if config.get("default_tier"):
                return config["default_tier"]
        
        # Check pipeline-level config
        if self.pipeline_def:
            pipeline_config = self.pipeline_def.get("model_config", {})
            if agent_id in pipeline_config.get("agents", {}):
                return pipeline_config["agents"][agent_id].get("tier")
            return pipeline_config.get("default_tier")
        
        # Default tier
        return "recommended"
    
    def load_pipeline(self, pipeline_file: str) -> bool:
        """Load a pipeline definition from file."""
        try:
            with open(pipeline_file, 'r', encoding='utf-8') as f:
                self.pipeline_def = json.load(f)
            
            # Create DAG executor
            self.dag_executor = DAGExecutor(self.pipeline_def)
            
            # Initialize execution state
            self.execution = PipelineExecution(
                pipeline_id=f"pipeline-{int(datetime.now().timestamp())}",
                project=self.project,
                pipeline_file=pipeline_file,
                phase=PipelinePhase.INIT,
                started_at=datetime.now().isoformat()
            )

            self._init_delegation()
            return True
        except Exception as e:
            print(f"[PipelineExecutor] Error loading pipeline: {e}")
            return False

    def _init_delegation(self):
        """(Re)build the delegation router from the loaded pipeline definition."""
        try:
            budget = DelegationBudget(
                max_invocations_per_stage=int(os.getenv("DELEGATION_MAX_PER_STAGE", "2")),
                max_total_invocations=int(os.getenv("DELEGATION_MAX_TOTAL", "8")),
                max_payload_chars=int(os.getenv("DELEGATION_MAX_PAYLOAD_CHARS", "4000")),
            )
            messenger = None
            try:
                from core.agent_messenger import AgentMessenger
                messenger = AgentMessenger(self.products_dir, self.project)
            except Exception:
                messenger = None
            self.delegation_router = DelegationRouter(
                self.pipeline_def, project=self.project,
                products_dir=self.products_dir, budget=budget, messenger=messenger)
        except Exception:
            self.delegation_router = None
    
