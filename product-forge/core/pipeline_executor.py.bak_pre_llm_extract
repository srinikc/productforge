    def _cheapest_opencode_go_model(self):
        """Cheapest enabled opencode-go model (cached). Used by breaker throttle."""
        cached = getattr(self, "_cheap_model_cache", None)
        if cached is not None:
            return cached
        try:
            models = [m for m in self.model_registry.list_models()
                      if getattr(m, "enabled", True) and getattr(m, "provider", "") == "opencode-go"]
            if models:
                cheap = min(models, key=lambda m: (m.cost_per_1k_input or 0) + (m.cost_per_1k_output or 0))
                self._cheap_model_cache = cheap
                return cheap
        except Exception:
            pass
        self._cheap_model_cache = None
        return None

    def _get_parent_stage_id(self, stage_id: str) -> Optional[str]:
        """Return the parent stage id for a derived stage.

        Examples:
            "4a-vqa" -> "4a"
            "4-0"    -> "4"
            "4a"     -> None   (no hyphen, nothing to inherit)
        """
        if stage_id and "-" in stage_id:
            return stage_id.rsplit("-", 1)[0]
        return None

    def _get_agent_model_config(self, agent_id: str, stage_id: str) -> dict:
        """Get model configuration for an agent from tier config.

        Resolution order (most specific wins):
          1. stage entry in the shared/project model-tier.json
          2. parent stage entry (e.g. "4a-vqa" inherits from "4a", "4-0" from "4")
          3. agent entry in the shared/project model-tier.json
          4. project config defaults
          5. env-overridable last-resort fallback
        """
        config = self._load_tier_config()

        # Breaker throttle: force the cheapest capable opencode-go model.
        if getattr(self, "_force_cheap", False):
            cheap = self._cheapest_opencode_go_model()
            if cheap:
                return {
                    "model": cheap.name,
                    "provider": cheap.provider,
                    "api_endpoint": config.get("api_endpoint", FALLBACK_ENDPOINT),
                    "fallback_models": [],
                    "tier": config.get("default_tier", "opencode-go-cheap"),
                }

        if config:
            try:
                default_provider = FALLBACK_PROVIDER
                default_endpoint = config.get("api_endpoint", FALLBACK_ENDPOINT)

                agent_cfg = config.get("agents", {}).get(agent_id, {})
                stage_cfg = config.get("stages", {}).get(stage_id, {})

                # Derived stages (VQA, skeleton) inherit their parent stage's
                # model when the stage itself has no explicit entry.
                parent_cfg = {}
                if not stage_cfg.get("model"):
                    parent_id = self._get_parent_stage_id(stage_id)
                    if parent_id:
                        parent_cfg = config.get("stages", {}).get(parent_id, {})

                model = (
                    stage_cfg.get("model")
                    or parent_cfg.get("model")
                    or agent_cfg.get("model")
                    or FALLBACK_MODEL
                )
                provider = (
                    stage_cfg.get("provider")
                    or parent_cfg.get("provider")
                    or agent_cfg.get("provider")
                    or default_provider
                )
                endpoint = (
                    stage_cfg.get("api_endpoint")
                    or parent_cfg.get("api_endpoint")
                    or agent_cfg.get("api_endpoint")
                    or default_endpoint
                )
                fallbacks = agent_cfg.get("fallback_models", [])

                return {
                    "model": model,
                    "provider": provider,
                    "api_endpoint": endpoint,
                    "fallback_models": fallbacks,
                    "tier": config.get("default_tier", "opencode-go-cheap"),
                }
            except Exception as e:
                print(f"[WARNING] Error resolving tier config: {e}")

        # No tier config found anywhere - use configurable last-resort defaults
        return {
            "model": FALLBACK_MODEL,
            "provider": FALLBACK_PROVIDER,
            "api_endpoint": FALLBACK_ENDPOINT,
        }
    
