  "brief": {
    "problem": "provider_limits unenforced; bursts risk 429s; pacing must not stall agents.",
    "what_adds": "rate_wait/record_request in capacity; _pace consults it; fail-open + capped.",
    "why": "Stay within provider limits under parallelism without blocking artifact production.",
    "who_feels": "Operators; pipeline reliability.",
    "source": "authored"
  },
  "objective": "Enforce provider_limits as a best-effort pace in the LLM path (capacity.rate_wait + _pace); fail-open, capped wait; never blocks artifacts.",
  "acceptance_criteria": [
    "core.capacity.provider_limits(provider) reads rpm/tpm from config",
    "rate_wait(provider) is bounded; unknown/broken -> 0 (fail-open)",
    "llm_client._pace consults rate_wait + records the request; capped; never raises",
    "an agent run is never blocked/aborted by the rate budget",
    "gate + tests cover pacing + fail-open"
  ],
  "in_scope": [
    "core/capacity.py rate budget",
    "llm_client._pace",
    "gate + tests"
  ],
