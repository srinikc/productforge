direction: down

title: Multi-Agent Multi-Project Pipeline — E2E Architecture

# ─── User Input ──────────────────────────────────────────────────────────────
user: User {
  shape: circle
  style: {
    fill: "#4a90d9"
    font-color: white
    bold: true
  }
}

input: New Idea / Change / Fix {
  style: {
    fill: "#e6f3ff"
    stroke: "#4a90d9"
  }
}

# ─── Stage 0: Ideation ──────────────────────────────────────────────────────
stages: {
  stage0: Stage 0: Ideation {
    style: {
      fill: "#f5f0ff"
      stroke: "#7b68ee"
      bold: true
      font-size: 18
    }

    ideation: Ideation Agent {
      style: {
        fill: "#7b68ee"
        font-color: white
        bold: true
      }
    }

    summary: Summary & Confirmation {
      style: {
        fill: "#e6e6fa"
        stroke: "#7b68ee"
      }
    }

    agent-meeting: Agent Query Meeting {
      style: {
        fill: "#e6e6fa"
        stroke: "#7b68ee"
      }
    }

    optional: Optional Requirements {
      style: {
        fill: "#fff0f5"
        stroke: "#7b68ee"
        stroke-dash: 5
      }
    }
  }

  # ─── Stages 1-3: Design & Review ─────────────────────────────────────────
  stage1: Stage 1: Design {
    style: {
      fill: "#f0ffff"
      stroke: "#20b2aa"
      bold: true
      font-size: 18
    }

    design: Design Agent {
      style: {
        fill: "#20b2aa"
        font-color: white
        bold: true
      }
    }
  }

  stage2: Stage 2: Architect {
    style: {
      fill: "#f0ffff"
      stroke: "#20b2aa"
      bold: true
      font-size: 18
    }

    architect: Architect Agent {
      style: {
        fill: "#20b2aa"
        font-color: white
        bold: true
      }
    }
  }

  stage3: Stage 3: Review {
    style: {
      fill: "#fff0f0"
      stroke: "#ff6347"
      bold: true
      font-size: 18
    }

    review: Review Agent {
      style: {
        fill: "#ff6347"
        font-color: white
        bold: true
      }
    }

    gate: APPROVED {
      shape: circle
      style: {
        fill: "#90ee90"
        stroke: "#228b22"
        bold: true
      }
    }
  }

  # ─── Stages 4-7: Implementation & Validation ─────────────────────────────
  stage4: Stage 4: Implement {
    style: {
      fill: "#fff8f0"
      stroke: "#ff8c00"
      bold: true
      font-size: 18
    }

    implement: Implement Agent {
      style: {
        fill: "#ff8c00"
        font-color: white
        bold: true
      }
    }
  }

  stage5: Stage 5: Code Review {
    style: {
      fill: "#fffff0"
      stroke: "#daa520"
      bold: true
      font-size: 18
    }

    code-review: Code Review Agent {
      style: {
        fill: "#daa520"
        font-color: white
        bold: true
      }
    }
  }

  stage6: Stage 6: Validate {
    style: {
      fill: "#f8f0ff"
      stroke: "#9370db"
      bold: true
      font-size: 18
    }

    validate: Validate Agent {
      style: {
        fill: "#9370db"
        font-color: white
        bold: true
      }
    }
  }

  stage7: Stage 7: Fix Loop {
    style: {
      fill: "#fff0f0"
      stroke: "#dc143c"
      bold: true
      font-size: 18
    }

    fix: Fix Agent {
      style: {
        fill: "#dc143c"
        font-color: white
        bold: true
      }
    }
  }
}

# ─── Artifacts ───────────────────────────────────────────────────────────────
artifacts: {
  product-plan: product-plan.md {
    style: {
      fill: "#f0f8ff"
      stroke: "#4682b4"
      italic: true
    }
  }

  requirements: requirements.md {
    style: {
      fill: "#f0f8ff"
      stroke: "#4682b4"
      italic: true
    }
  }

  design-doc: design.md {
    style: {
      fill: "#f0f8ff"
      stroke: "#4682b4"
      italic: true
    }
  }

  architecture: architecture.md {
    style: {
      fill: "#f0f8ff"
      stroke: "#4682b4"
      italic: true
    }
  }

  arch-spec: architecture-spec.json {
    style: {
      fill: "#fff8dc"
      stroke: "#daa520"
      italic: true
    }
  }

  review-doc: review.md {
    style: {
      fill: "#fff0f0"
      stroke: "#ff6347"
      italic: true
    }
  }

  src: src/ {
    style: {
      fill: "#f5f5dc"
      stroke: "#8b4513"
      bold: true
    }
  }

  code-review: code-review.md {
    style: {
      fill: "#f0f8ff"
      stroke: "#4682b4"
      italic: true
    }
  }

  issues: issues.md {
    style: {
      fill: "#fff0f0"
      stroke: "#dc143c"
      italic: true
    }
  }
}

# ─── Recovery Components ─────────────────────────────────────────────────────
recovery: Failure Recovery {
  style: {
    fill: "#fffacd"
    stroke: "#daa520"
    bold: true
    font-size: 16
  }

  checkpoints: Checkpoints {
    style: {
      fill: "#fffacd"
      stroke: "#daa520"
    }
  }

  dlq: Dead Letter Queue {
    style: {
      fill: "#ffe4e1"
      stroke: "#dc143c"
    }
  }

  circuit-breakers: Circuit Breakers {
    style: {
      fill: "#e6ffe6"
      stroke: "#228b22"
    }
  }
}

# ─── Model Tiers ─────────────────────────────────────────────────────────────
model-tiers: Model Tiers {
  style: {
    fill: "#f0f0f0"
    stroke: "#808080"
    bold: true
    font-size: 16
  }

  recommended: Recommended (2.00/run) {
    style: {
      fill: "#e6f3ff"
      stroke: "#4a90d9"
    }
  }

  cheap: Cheap (0.47/run) {
    style: {
      fill: "#f0fff0"
      stroke: "#228b22"
    }
  }

  hybrid: Hybrid (0.90/run) {
    style: {
      fill: "#fff8f0"
      stroke: "#ff8c00"
    }
  }

  free: ZenFree (Free) {
    style: {
      fill: "#f8f8f8"
      stroke: "#808080"
    }
  }
}

# ─── Connections ─────────────────────────────────────────────────────────────
user -> input: provides
input -> stages.stage0.ideation: triggers

# Stage 0 flow
stages.stage0.ideation -> stages.stage0.summary: accept idea
stages.stage0.summary -> stages.stage0.agent-meeting: confirmed
stages.stage0.agent-meeting -> stages.stage0.optional: collect optional
stages.stage0.optional -> artifacts.product-plan: synthesize

# Stage 0 to Stage 1
artifacts.product-plan -> stages.stage1.design: Stage 1

# Stage 1 outputs
stages.stage1.design -> artifacts.requirements: writes
stages.stage1.design -> artifacts.design-doc: writes

# Stage 1 to Stage 2
artifacts.requirements -> stages.stage2.architect: Stage 2
artifacts.design-doc -> stages.stage2.architect: Stage 2

# Stage 2 outputs
stages.stage2.architect -> artifacts.architecture: writes
stages.stage2.architect -> artifacts.arch-spec: writes

# Stage 2 to Stage 3
artifacts.architecture -> stages.stage3.review: Stage 3

# Stage 3 gate
stages.stage3.review -> artifacts.review-doc: writes verdict
artifacts.review-doc -> stages.stage3.gate: verdict

# Stage 3 to Stage 4 (gate)
stages.stage3.gate -> stages.stage4.implement: APPROVED

# Stage 4 outputs
stages.stage4.implement -> artifacts.src: writes code

# Stage 4 to Stage 5
artifacts.src -> stages.stage5.code-review: Stage 5

# Stage 5 outputs
stages.stage5.code-review -> artifacts.code-review: writes

# Stage 5 to Stage 6
artifacts.code-review -> stages.stage6.validate: Stage 6

# Stage 6 outputs
stages.stage6.validate -> artifacts.issues: writes issues

# Stage 6 to Stage 7 (if issues)
artifacts.issues -> stages.stage7.fix: has issues

# Fix loop
stages.stage7.fix -> artifacts.src: fixes code
stages.stage7.fix -> stages.stage6.validate: re-validate

# Recovery connections
stages.stage0.ideation -> recovery.checkpoints: save state
stages.stage1.design -> recovery.checkpoints: save state
stages.stage2.architect -> recovery.checkpoints: save state
stages.stage3.review -> recovery.checkpoints: save state
stages.stage4.implement -> recovery.checkpoints: save state
stages.stage5.code-review -> recovery.checkpoints: save state
stages.stage6.validate -> recovery.checkpoints: save state
stages.stage7.fix -> recovery.checkpoints: save state

recovery.circuit-breakers -> recovery.dlq: 5+ failures
