direction: right

title: "Multi-Agent Pipeline — Models, Costs & Flow"

# ─── User Input ───────────────────────────────────────────────────────────────
user: User {
  shape: circle
  style: {
    fill: "#4a90d9"
    font-color: white
    bold: true
    font-size: 28
  }
}

# ─── Stage 0: Ideation ───────────────────────────────────────────────────────
ideation: "0 Ideation\nmimo-v2.5\n~0.02" {
  style: {
    fill: "#f5f0ff"
    stroke: "#7b68ee"
    bold: true
    border-radius: 8
    font-size: 28
    font-color: "#4a0080"
  }
}

# ─── Stage 1: Design ─────────────────────────────────────────────────────────
