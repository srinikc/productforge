      font-size: 24
    }
  }

  arch: "architecture.md" {
    style: {
      fill: "#f0f8ff"
      italic: true
      font-size: 24
    }
  }

  arch-d2: "architecture.d2" {
    style: {
      fill: "#f0f8ff"
      italic: true
      font-size: 24
    }
  }

  review-doc: "review.md" {
    style: {
      fill: "#fff0f0"
      italic: true
      font-size: 24
    }
  }

  code: "src/" {
    style: {
      fill: "#f5f5dc"
      bold: true
      font-size: 24
    }
  }

  cr: "code-review.md" {
    style: {
      fill: "#f0f8ff"
      italic: true
      font-size: 24
    }
  }

  issues: "issues.md" {
    style: {
      fill: "#fff0f0"
      italic: true
      font-size: 24
    }
  }
}

