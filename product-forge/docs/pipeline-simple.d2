# ─── Done ─────────────────────────────────────────────────────────────────────
done: "Done\nTotal: ~2.00" {
  shape: circle
  style: {
    fill: "#90ee90"
    stroke: "#228b22"
    bold: true
    font-size: 28
  }
}

# ─── Connections ──────────────────────────────────────────────────────────────
user -> ideation: idea {
  style: {
    font-size: 22
  }
}
ideation -> design: product-plan {
  style: {
    font-size: 22
  }
}
design -> architect: requirements + design {
  style: {
    font-size: 22
  }
}
architect -> review: architecture {
  style: {
    font-size: 22
  }
}
review -> gate: verdict {
  style: {
    font-size: 22
  }
}
gate -> implement: APPROVED {
  style: {
    font-size: 22
  }
}
implement -> code-review: code {
  style: {
    font-size: 22
  }
}
code-review -> validate: review {
  style: {
    font-size: 22
  }
}
validate -> fix: issues {
  style: {
    font-size: 22
  }
}
fix -> implement: fixes {
  style: {
    font-size: 22
  }
}
validate -> done: PASS {
  style: {
    font-size: 22
  }
}

# ─── Artifacts (side panel) ──────────────────────────────────────────────────
artifacts: Artifacts {
  style: {
    fill: "#fffacd"
    stroke: "#daa520"
    border-radius: 8
    font-size: 26
  }

  plan: "product-plan.md" {
    style: {
      fill: "#f0f8ff"
      italic: true
      font-size: 24
    }
  }

  reqs: "requirements.md" {
    style: {
      fill: "#f0f8ff"
      italic: true
