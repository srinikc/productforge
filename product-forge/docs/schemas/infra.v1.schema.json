{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://product-forge.dev/schemas/infra.v1.schema.json",
  "title": "Infrastructure Profile",
  "description": "products/<project>/docs/infra.json — infra/deploy profile derived by the architect from product kind + requirements/NFRs.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "kind": {"type": "string"},
    "compute": {"type": ["string", "array", "object"]},
    "storage": {"type": ["string", "array", "object"]},
    "networking": {"type": ["string", "array", "object"]},
    "identity": {"type": ["string", "array", "object"]},
    "observability": {"type": ["string", "array", "object"]},
    "environments": {"type": ["string", "array", "object"]},
    "vendors": {"type": ["string", "array", "object"]},
    "packaging": {"type": ["string", "array", "object"]},
    "deploy": {"type": ["string", "array", "object"]},
    "data_compliance": {"type": ["string", "array", "object"]},
    "cost": {"type": ["string", "array", "object"]},
    "unknowns": {"type": "array"},
    "rationale": {"type": "string"}
  }
}
