{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.5",
  "provider": {
    "opencode-go": {
      "name": "OpenCode Go (Exploring / Account A)",
      "options": {
        "apiKey": "{file:.opencode/opencode.key}"
      }
    },
    "openrouter": {
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "opencode": {
      "name": "OpenCode Zen (Exploring / Account A)",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "{file:.opencode/opencode.key}"
      }
    }
  },
  "mcp": {
    "openflowkit": {
      "type": "local",
      "command": ["npx", "-y", "@vrun-design/openflowkit-mcp"],
      "enabled": true
    },
    "drawio": {
      "type": "local",
      "command": ["npx", "-y", "@drawio/mcp"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow"
  }
}