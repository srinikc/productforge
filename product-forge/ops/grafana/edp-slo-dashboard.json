{
  "title": "EDP-22 Store SLOs",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {"id": 1, "title": "Benchmark p95 by scenario", "type": "timeseries", "targets": [{"expr": "edp_bench_p95_ms"}]},
    {"id": 2, "title": "Benchmark p99 by scenario", "type": "timeseries", "targets": [{"expr": "edp_bench_p99_ms"}]},
    {"id": 3, "title": "Store errors", "type": "timeseries", "targets": [{"expr": "sum by (store) (rate(edp_store_requests_total{outcome=\"error\"}[5m]))"}]},
    {"id": 4, "title": "Store degraded", "type": "stat", "targets": [{"expr": "edp_store_degraded"}]},
    {"id": 5, "title": "Quota denials", "type": "timeseries", "targets": [{"expr": "sum by (store, scope) (rate(edp_quota_denials_total[5m]))"}]},
    {"id": 6, "title": "Baseline freshness", "type": "stat", "targets": [{"expr": "time() - edp_bench_last_run_unixtime"}]}
  ]
}
