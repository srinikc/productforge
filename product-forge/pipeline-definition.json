  "agent_capabilities": {
    "orchestrator": {
      "scope": "manage_pipeline",
      "can_invoke": [
        "ideation",
        "design",
        "architect",
        "implement",
        "devops",
        "code-review",
        "fix",
        "validate",
        "security",
        "document",
        "package",
        "discovery",
        "product-design-spec",
        "ux-ia"
      ],
      "on_complete": "human_approval"
    },
    "ideation": {
      "scope": "capture_idea",
      "can_invoke": [
        "design"
      ],
      "on_complete": "design"
    },
    "discovery": {
      "scope": "multi_perspective_ideation",
      "sub_agents": [
        "product-analyst",
        "business-analyst",
        "ux-researcher"
      ],
      "can_invoke": [
        "design",
        "orchestrator"
      ],
      "on_complete": "design",
      "model_preferences": {
        "product-analyst": "gpt-4o",
        "business-analyst": "claude-3-sonnet",
        "ux-researcher": "gpt-4o-mini"
      }
    },
    "design": {
      "scope": "create_requirements_and_design",
      "can_invoke": [
        "architect"
      ],
      "on_complete": "design_critic"
    },
    "product-design-spec": {
      "scope": "create_product_design_specification",
      "can_invoke": [
        "design-critic",
        "orchestrator"
      ],
      "on_complete": "design_critic",
      "artifact_type": "product-design-spec"
    },
    "design_critic": {
      "scope": "review_design_quality",
      "can_invoke": [
        "orchestrator",
        "design"
      ],
      "decision_logic": {
        "passed": "orchestrator",
        "failed": "design"
      },
      "on_complete": "orchestrator"
    },
    "ux-ia": {
      "scope": "review_ux_and_information_architecture",
      "can_invoke": [
        "orchestrator"
      ],
      "on_complete": "orchestrator",
      "artifact_type": "design-tokens"
    },
    "architect": {
      "scope": "create_architecture",
      "can_invoke": [
        "implement",
        "orchestrator"
      ],
      "on_complete": "orchestrator"
    },
    "implement": {
      "scope": "write_code",
      "sub_agents": [
        "implement-db",
        "implement-api",
        "implement-logic",
        "implement-ui"
      ],
      "can_invoke": [
        "devops",
        "code-review",
        "architect",
        "implement-db",
        "implement-api",
        "implement-logic",
        "implement-ui"
      ],
      "on_complete": "devops"
    },
    "implement-db": {
      "scope": "write_database_code",
      "can_invoke": [
        "implement-api",
        "implement"
      ],
      "on_complete": "implement-api"
    },
    "implement-api": {
      "scope": "write_api_code",
      "can_invoke": [
        "implement-logic",
        "implement-db",
        "implement"
      ],
      "on_complete": "implement-logic"
    },
    "implement-logic": {
      "scope": "write_business_logic",
      "can_invoke": [
        "implement-ui",
        "implement-api",
        "implement"
      ],
      "on_complete": "implement-ui"
    },
    "implement-ui": {
      "scope": "write_ui_code",
      "can_invoke": [
        "implement",
        "devops"
      ],
      "on_complete": "devops"
    },
    "devops": {
      "scope": "build_and_deploy",
      "can_invoke": [
        "code-review",
        "orchestrator"
      ],
      "on_complete": "code-review"
    },
    "code-review": {
      "scope": "review_code",
      "can_invoke": [
        "fix",
        "architect",
        "validate",
        "orchestrator"
      ],
      "decision_logic": {
        "code_issue": "fix",
        "architecture_issue": "architect",
        "approved": "validate",
        "human_change": "orchestrator"
      },
      "on_complete": "validate"
    },
    "fix": {
      "scope": "fix_issues",
      "can_invoke": [
        "validate",
        "code-review",
        "implement"
      ],
      "decision_logic": {
        "fixed": "code-review",
        "reviewed": "validate",
        "still_broken": "code-review",
        "major_change_needed": "implement"
      },
      "on_complete": "code-review"
    },
    "validate": {
      "scope": "run_tests",
      "can_invoke": [
        "orchestrator",
        "fix"
      ],
      "decision_logic": {
        "tests_pass": "orchestrator",
        "tests_fail": "fix"
      },
      "on_complete": "orchestrator"
    },
    "security": {
      "scope": "security_scan",
      "can_invoke": [
        "fix",
        "orchestrator"
      ],
      "decision_logic": {
        "issues_found": "fix",
        "clean": "orchestrator"
      },
      "on_complete": "orchestrator"
    },
    "visual_qa": {
      "scope": "validate_visual_output",
      "can_invoke": [
        "orchestrator",
        "fix"
      ],
      "decision_logic": {
        "passed": "orchestrator",
        "failed": "fix"
      },
      "on_complete": "orchestrator"
    },
    "document": {
      "scope": "create_documentation",
      "can_invoke": [
        "orchestrator"
      ],
      "on_complete": "orchestrator"
    },
    "package": {
      "scope": "package_artifacts",
      "can_invoke": [
        "orchestrator"
      ],
      "on_complete": "orchestrator"
    }
  },
  "budget_tracking": {
    "enabled": true,
    "total_budget": 100.0,
    "alert_threshold": 80,
    "currency": "USD"
  },
  "stuck_detection": {
    "timeout_minutes": 10,
    "check_interval_minutes": 2,
    "max_retries": 3,
    "on_stuck": "factory_supervisor_intervenes"
  },
  "loop_detection": {
    "max_repeats": 3,
    "on_loop": "forced_convergence"
  },
  "convergence": {
    "max_idle_cycles": 5,
    "escalate_after_cycles": 3,
    "actions": [
      "skip",
      "escalate",
      "force_complete",
      "auto_resolve",
      "terminate"
    ]
  },
  "parallel_groups": [
    {
      "name": "design-reviews",
      "stages": [
        "1b",
        "1c"
      ],
      "runs_after": [
        "1a"
      ],
      "converges_at": "2"
    },
    {
      "name": "verification",
      "stages": [
        "5",
        "6"
      ],
      "runs_after": [
        "4c-vqa"
      ],
      "converges_at": "7"
    }
  ]
}
