{
  "name": "Monitoring Engine",
  "version": "1.0.0",
  "description": "Pipeline template for monitoring and observability systems",
  "category": "monitoring",
  "stages": {
    "requirement-analysis": {
      "name": "Requirement Analysis",
      "type": "sequential",
      "depends_on": [],
      "agents": [
        {
          "id": "ideation",
          "task": "Define monitoring requirements: metrics, logs, traces, alerts, and SLIs/SLOs"
        }
      ]
    },
    "metrics-design": {
      "name": "Metrics Design",
      "type": "sequential",
      "depends_on": ["requirement-analysis"],
      "agents": [
        {
          "id": "design",
          "task": "Design metrics schema, naming conventions, and dashboard layouts"
        }
      ]
    },
    "architecture": {
      "name": "Architecture Design",
      "type": "sequential",
      "depends_on": ["metrics-design"],
      "agents": [
        {
          "id": "architect",
          "task": "Design monitoring architecture: collection, storage, processing, alerting"
        }
      ]
    },
    "implementation": {
      "name": "Implementation",
      "type": "parallel",
      "depends_on": ["architecture"],
      "agents": [
        {
          "id": "implementation",
          "task": "Implement metrics collectors, log aggregators, and trace collectors"
        },
        {
          "id": "implementation",
          "task": "Implement alerting rules and notification channels"
        }
      ]
    },
    "testing": {
      "name": "Testing",
      "type": "sequential",
      "depends_on": ["implementation"],
      "agents": [
        {
          "id": "quality",
          "task": "Test monitoring: load test metrics, validate alerts, verify dashboards"
        }
      ]
    },
    "documentation": {
      "name": "Documentation",
      "type": "sequential",
      "depends_on": ["testing"],
      "agents": [
        {
          "id": "document",
          "task": "Document runbooks, dashboards, alerting rules, and troubleshooting guides"
        }
      ]
    }
  },
  "knowledge_domains": ["monitoring", "observability", "alerting", "metrics", "logging", "tracing", "performance", "scaling"],
  "compliance": {
    "required_checks": ["architecture-review", "security-audit"],
    "sla_requirements": ["99.9% uptime", "<1min alert latency", "<5s dashboard load"]
  },
  "metadata": {
    "created_at": "2026-09-03",
    "created_by": "Pipeline Template Generator"
  }
}
