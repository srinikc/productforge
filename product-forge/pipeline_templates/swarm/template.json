{
  "id": "swarm",
  "version": "1.0.0",
  "name": "Agent Swarm Pipeline",
  "description": "Multiple agents working together in parallel on complex tasks",
  "type": "dynamic",
  "category": "swarm",
  "stages": {
    "0": {"name": "Ideation", "agent": "ideation", "type": "sequential", "depends_on": []},
    "1": {"name": "Planning", "agent": "strategist", "type": "sequential", "depends_on": ["0"]},
    "2": {"name": "Swarm Execution", "type": "swarm", "depends_on": ["1"], "agents": [{"id": "analyst", "role": "analyzer"}, {"id": "researcher", "role": "researcher"}, {"id": "content-creator", "role": "creator"}]},
    "3": {"name": "Synthesis", "agent": "orchestrator", "type": "sequential", "depends_on": ["2"]},
    "4": {"name": "Document", "agent": "document", "type": "sequential", "depends_on": ["3"]}
  },
  "metadata": {"author": "system", "tags": ["swarm", "parallel", "multi-agent"]}
}